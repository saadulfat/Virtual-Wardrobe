# Database Configuration
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/wardrobe

# Application Secret Key (use a strong random string)
SECRET_KEY=your_super_secret_key_here_change_this_immediately

# API Keys - Replace with your actual API keys
KIE_API_KEY=your_kie_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
STABILITY_API_KEY=your_stability_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Credentials (when running outside Docker)
MYSQL_ROOT_PASSWORD=your_secure_password
MYSQL_DATABASE=wardrobe
MYSQL_USER=wardrobe_user
MYSQL_PASSWORD=your_wardrobe_user_password

# Other Configuration
DEBUG=False
LOG_LEVEL=info